# true (default) uses the in-browser mock so every screen is clickable
# without the Go server. Set false to talk to rsp-server via the Vite proxy.
VITE_USE_MOCK=true

# Used when VITE_USE_MOCK=false. /api is rewritten to the Go process.
VITE_API_BASE=/api

# Blank uses the Vite host (/ws proxied to :8080). Set this only if the
# browser should open the Go WebSocket directly.
VITE_WS_URL=

# Same Google Cloud web client ID as GOOGLE_CLIENT_ID on the server.
# Leave unset to hide the Continue with Gmail button.
VITE_GOOGLE_CLIENT_ID=
