# Local Vite proxies /api and /ws to the Go process on :8080.
VITE_API_BASE=/api

# Blank uses the Vite host (/ws proxied to :8080). On Vercel set this to
# the Render WebSocket origin, e.g. wss://rsp-api.onrender.com/ws
VITE_WS_URL=

# Same Google Cloud web client ID as GOOGLE_CLIENT_ID on the server.
# Leave unset to hide the Continue with Gmail button.
VITE_GOOGLE_CLIENT_ID=
