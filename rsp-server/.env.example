# Copy to .env and adjust. No real secrets belong in this file.

# HTTP listen address for cmd/server.
HTTP_ADDR=:8080

# dev | production. /dev/guest and X-Player-ID exist only in dev.
APP_ENV=dev

# How long a disconnected player keeps their seat.
DISCONNECT_GRACE=20s

# Postgres — Compose publishes the container's 5432 on the host as 5433 so a
# native Postgres on 5432 can coexist. Inside Compose, migrate uses db:5432.
POSTGRES_USER=rsp
POSTGRES_PASSWORD=rsp
POSTGRES_DB=rsp
POSTGRES_PORT=5433

# Used by the Go app and by `make migrate-up` from the host (not by Compose migrate).
DATABASE_URL=postgres://rsp:rsp@localhost:5433/rsp?sslmode=disable

# Auth. Put the real JWT_SECRET in .env — never commit it.
# Required when APP_ENV=production.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
REFRESH_TOKEN_TTL_REMEMBER=720h
PASSWORD_RESET_TTL=1h
BCRYPT_COST=12

# Reset-link origin shown in the email (and logged in dev).
PUBLIC_BASE_URL=http://localhost:5173

# Email. log (default, prints the reset URL) | resend | smtp
EMAIL_PROVIDER=log
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Google Sign-In. Verify ID tokens server-side. No client secret.
# Leave unset to disable POST /auth/google (returns 503).
GOOGLE_CLIENT_ID=
