# Copy to .env and adjust. No real secrets belong in this file.

# HTTP listen address for cmd/server. Empty + PORT (Render) → :$PORT.
HTTP_ADDR=:8080
# PORT=

# dev | production. /dev/guest and X-Player-ID exist only in dev.
# Production refuses a missing JWT_SECRET, the documented dev JWT default,
# EMAIL_PROVIDER=log, an empty CORS_ORIGINS, and an empty DATABASE_URL.
APP_ENV=dev

# How long a disconnected player keeps their seat.
DISCONNECT_GRACE=20s

# Postgres — Compose publishes the container's 5432 on the host as 5433 so a
# native Postgres on 5432 can coexist. Inside Compose, migrate uses db:5432.
# Passwords come from the environment; the local default is rsp (never for prod).
POSTGRES_USER=rsp
POSTGRES_PASSWORD=rsp
POSTGRES_DB=rsp
POSTGRES_PORT=5433

# Used by the Go app and by `make migrate-up` from the host (not by Compose migrate).
# sslmode=disable is for local Compose / a private Docker network.
# Supabase / internet: sslmode=require (or verify-full).
# Pooler (:6543, pgbouncer) is fine for the API. golang-migrate needs a
# direct session (db.<ref>.supabase.co:5432) — set DATABASE_URL_MIGRATE.
DATABASE_URL=postgres://rsp:rsp@localhost:5433/rsp?sslmode=disable
DATABASE_URL_MIGRATE=
# 1 (default) = Docker entrypoint runs migrate up. 0 = skip (you ran make migrate-up).
RUN_MIGRATIONS=1

# Auth. Put the real JWT_SECRET in .env — never commit it.
# Required when APP_ENV=production. Must not be the documented dev default.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
REFRESH_TOKEN_TTL_REMEMBER=720h
PASSWORD_RESET_TTL=1h
BCRYPT_COST=12

# Reset-link origin shown in the email (and logged in dev).
PUBLIC_BASE_URL=http://localhost:5173

# Email. log (default, prints the reset URL) | resend | smtp
# log is forbidden when APP_ENV=production.
EMAIL_PROVIDER=log
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Google Sign-In. Verify ID tokens server-side. No client secret.
# Leave unset to disable POST /auth/google (returns 503).
GOOGLE_CLIENT_ID=

# Comma-separated browser origins. Empty in dev = allow any Origin.
# Required when APP_ENV=production (REST CORS and WebSocket CheckOrigin).
# Example: http://localhost:5173,https://play.example.com
CORS_ORIGINS=

# Unauthenticated auth POSTs (register/login/guest/google/forgot/reset/refresh)
# per client IP per minute. Production default is 20.
RATE_LIMIT_AUTH_PER_MIN=20

# Comma-separated proxy CIDRs/IPs for gin ClientIP / X-Forwarded-For.
# Empty = trust no proxies (local). Behind compose nginx, use private ranges.
TRUSTED_PROXIES=
