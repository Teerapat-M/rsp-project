# Copy to .env and adjust. No real secrets belong in this file.

# HTTP listen address for cmd/server.
HTTP_ADDR=:8080

# How long a disconnected player keeps their seat (phase 2).
DISCONNECT_GRACE=20s

# Postgres — matches docker-compose.yml defaults.
POSTGRES_USER=rsp
POSTGRES_PASSWORD=rsp
POSTGRES_DB=rsp
POSTGRES_PORT=5432

# Used by the Go app and by `make migrate-up` from the host.
DATABASE_URL=postgres://rsp:rsp@localhost:5432/rsp?sslmode=disable

# Auth (phase 4). Put the real JWT_SECRET in .env — never commit it.
# JWT_SECRET=
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=168h
# REFRESH_TOKEN_TTL_REMEMBER=720h
# PASSWORD_RESET_TTL=1h
# BCRYPT_COST=12
